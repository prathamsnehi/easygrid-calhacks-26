{
  "name": "@easygrid/contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "openapi.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "generate": "node --experimental-strip-types scripts/generate.ts",
    "check:generated": "node --experimental-strip-types scripts/generate.ts --check",
    "check": "npm run typecheck && npm test && npm run check:generated && npm run build"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
