              "basis": {
                "type": "string",
                "const": "route-impact-v1"
              },
              "recommendedOfferCents": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "offerCapCents": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "policyId",
              "basis",
              "recommendedOfferCents",
              "offerCapCents"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "sessionId",
        "projectId",
        "routeId",
        "routeVersion",
        "revision",
        "termsVersions"
      ],
      "additionalProperties": false
    },
    "SettlementContext": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "current": {
          "type": "object",
