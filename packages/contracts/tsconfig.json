{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "NodeNext",
    "moduleResolution": "NodeNext", "strict": true, "noUncheckedIndexedAccess": true,
    "declaration": true, "outDir": "dist", "rootDir": "src", "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true, "erasableSyntaxOnly": true
  },
  "include": ["src/**/*.ts"]
}
