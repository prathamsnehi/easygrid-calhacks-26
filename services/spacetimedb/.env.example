# Maincloud target for this deployment only.
SPACETIMEDB_URI=https://maincloud.spacetimedb.com
# Set an explicit database name; do not inherit another developer's test DB.
SPACETIMEDB_DATABASE=
# Optional application/client identity token; this is not a CLI deployment token.
# Leave empty for a new client identity. Authorization is implemented in CAL-29.
SPACETIMEDB_TOKEN=
