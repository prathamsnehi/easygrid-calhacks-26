# Copy to .env.voice. Keep actual credentials only in that ignored private file.
# Enable only after provisioning and publishing the matching SpacetimeDB module.
EASYGRID_VOICE_ENABLED=no
SPACETIMEDB_URI=https://maincloud.spacetimedb.com
SPACETIMEDB_DATABASE=YOUR_PUBLISHED_DATABASE
SPACETIMEDB_TOKEN=YOUR_STABLE_APPLICATION_IDENTITY_TOKEN
CARTESIA_API_KEY=YOUR_CARTESIA_API_KEY
CARTESIA_AGENT_ID=YOUR_PROVISIONED_AGENT_ID
CARTESIA_FROM_NUMBER_ID=YOUR_CARTESIA_FROM_NUMBER_ID
EASYGRID_VOICE_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Required for provisioning and the read-only verification at server startup.
# Expose only the two /api/voice/tools/* routes described in CAL33_LIVE_VOICE.md.
EASYGRID_VOICE_PUBLIC_URL=https://YOUR_TOOL_PROXY_HOST
CARTESIA_VOICE_ID=YOUR_CARTESIA_VOICE_ID
CARTESIA_MODEL_ID=YOUR_CARTESIA_MODEL_ID

# Voice acceptance never sends a payment. Keep the separate payment demo local.
EASYGRID_PAYMENT_PROVIDER=simulation
